<?xml version="1.0" encoding="UTF-8"?>

<fileset-config file-format-version="1.2.0" simple-config="true" sync-formatter="false">
  <fileset name="all" enabled="true" check-config-name="SysON" local="false">
    <file-match-pattern match-pattern="." include-pattern="true"/>
    <file-match-pattern match-pattern="^src[/\\]main[/\\]java[/\\]org[/\\]eclipse[/\\]syson[/\\]sysml[/\\]parser[/\\]SysMLModelParser\.java$" include-pattern="false"/>
    <file-match-pattern match-pattern="^src[/\\]main[/\\]java[/\\]org[/\\]eclipse[/\\]syson[/\\]sysml[/\\]parser[/\\]internal[/\\]SysMLLexer\.java$" include-pattern="false"/>
    <file-match-pattern match-pattern="^src[/\\]main[/\\]java[/\\]org[/\\]eclipse[/\\]syson[/\\]sysml[/\\]parser[/\\]internal[/\\]SysMLParser\.java$" include-pattern="false"/>
    <file-match-pattern match-pattern="^src[/\\]main[/\\]java[/\\]org[/\\]eclipse[/\\]syson[/\\]sysml[/\\]parser[/\\]internal[/\\]AbstractSysMLEMFParser\.java$" include-pattern="false"/>
  </fileset>
  <filter name="FilesFromPackage" enabled="true">
    <filter-data value="src/main/resources"/>
    <filter-data value="src/test/resources"/>
  </filter>
</fileset-config>
