  item def Indenture specializes SecuritiesIssuanceAgreement, Contracts::WrittenContract {
  	doc /* A written contract, also known as a &quot;Deed of Trust&quot;, under which bonds and debentures are issued, setting forth maturity date, interest rate, redemption rights, call privileges and other terms. Under the rules of the Trust Indenture Act of 1939, the contract is executed by the issuer and a trustee who acts on behalf of the bondholders. */
  	// skos:definition xml:lang="en" (IssuanceDocuments.rdf)
