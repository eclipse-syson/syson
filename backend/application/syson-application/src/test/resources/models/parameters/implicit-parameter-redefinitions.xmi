<!--
package ImplicitParameterProbe {
    action def A { in p1; out p2; }
    action def Other { in q1; out q2; }
    action def Simple :> A { in local1; out local2; }
    action def Deep :> Simple { in deep1; out deep2; }
    action def Multiple :> A, Other { in merged1; out merged2; }
    action def Mixed :> A, Other { in explicit1 :>> A::p1; out automatic2; }
    action instance : A { in usage1; out usage2; }
    action anonymous : A { in ref; }
}
-->
