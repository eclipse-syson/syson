<!--
Original model : 
package 'Package 1' {

  // referinition
  part def Part1 {
    protected attribute attribute1;
  }

  part def Part2 :> Part1 {
    attribute :>> attribute1 = 3;
  }

  // chainingFeature
  action def Action1;
  action def Action2;
  action def Action3;

  action action1 : Action1 {
    action action2 : Action2;
    action action2 : Action3;
  }

  part Part3 {
    perform action1.action2;
  }
}


-->

