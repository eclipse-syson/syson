<?xml version="1.0" encoding="UTF-8"?>
<!--
package NestedRedefinitions {
    part def Child {
        attribute x;
        attribute preserved;
    }
    part def RefinedChild :> Child {
        attribute refined redefines Child::x;
    }
    part def Base {
        part sub : Child;
    }
    part def Derived :> Base {
        part redefines Base::sub {
            attribute renamed redefines Child::x;
        }
    }
    part def Refined :> Base {
        part sub : RefinedChild redefines Base::sub {
            attribute localValue;
        }
    }
    part def Occurrences {
        part original : Child;
        part configured : RefinedChild;
    }
}
-->
