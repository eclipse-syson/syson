package TypingBoundaries {
    attribute def Scalar;
    part def A {
        attribute a;
    }
    part def B {
        attribute b;
    }
    part def Context {
        part mixed : A, B;
        attribute scalar : Scalar;

        part def Internal {
            attribute hidden;
        }
    }
}
-->
