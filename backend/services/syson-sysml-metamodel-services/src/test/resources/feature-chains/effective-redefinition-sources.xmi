<?xml version="1.0" encoding="UTF-8"?>
<!--
package EffectiveRedefinitionSources {
    part def Leaf {
        attribute value;
    }
    port def Endpoint {
        attribute signal;
        port nested;
    }
    action def Work {
        attribute setting;
    }
    part def Root {
        part child : Leaf;
        attribute amount;
        ref reference : Leaf;
        port endpoint : Endpoint;
        action work : Work;
    }
    part def Renamed :> Root {
        attribute renamed :>> amount;
    }
    part def Transitive :> Renamed {
        attribute finalValue :>> renamed;
    }
    part def Anonymous :> Root {
        attribute :>> amount;
    }
    part def Left :> Root;
    part def Right :> Root {
        attribute rightAmount :>> amount;
    }
    part def Diamond :> Left, Right;
    part def ReverseDiamond :> Right, Left;
    part renamed : Renamed;
    part transitive : Transitive;
    part anonymous : Anonymous;
    part diamond : Diamond;
    part reverseDiamond : ReverseDiamond;
    part plain : Root;
    part def Abbreviated :> Root {
        :>> amount;
    }
    part abbreviated : Abbreviated;
    part localReference : Root {
        :>> child;
    }
    part conflict : Root {
        part :>> child {
            attribute firstValue :>> Leaf::value;
            attribute secondValue :>> Leaf::value;
        }
    }
    connection def Link {
        end part source;
        end part target;
    }
    connection link : Link;
    connection def Wired {
        part a;
        part b;
        connection wire connect a to b;
    }
    connection wireCopy :> Wired::wire;
}
-->
