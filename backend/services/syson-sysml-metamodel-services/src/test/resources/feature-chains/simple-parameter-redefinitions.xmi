<!--
package SimpleParameterRedefinitions {
    action def Process {
        in attribute input;
        attribute setting;
        out item output;
        inout part currentState;
        in attribute extra;
    }
    action processUse : Process;
    action def Specialized :> Process;
    action def OneParameter {
        in attribute value;
    }
    action single : OneParameter;
    action def UnsupportedPrefix {
        in attribute firstParameter;
        in attribute earlier;
        out attribute selected;
    }
    action rejected : UnsupportedPrefix;
}
-->
