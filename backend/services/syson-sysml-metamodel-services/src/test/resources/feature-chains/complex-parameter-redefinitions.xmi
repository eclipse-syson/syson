<?xml version="1.0" encoding="UTF-8"?>
<!--
package ComplexParameterRedefinitions {
    item def Payload { attribute value; }
    action def Base {
        in item input : Payload;
        out attribute output;
        inout part currentState;
    }
    action def Linear :> Base;
    action def Renamed :> Base {
        in item renamed :>> input;
    }
    action def Other {
        in ref request : Payload;
        out attribute response;
        inout part status;
        in attribute extra;
    }
    action def Multiple :> Base, Other;
    action def Left :> Base;
    action def Right :> Base;
    action def Diamond :> Left, Right;
    action def Wrapped :> Multiple;
    action def Incompatible {
        out item request : Payload;
    }
    action def Conflict :> Base, Incompatible;
    action simple : Base;
    action linear : Linear;
    action renamed : Renamed;
    action multiple : Multiple;
    action mergedPartial : Multiple { in item localInput :>> Base::input; }
    action diamond : Diamond;
    action wrapped : Wrapped;
    action conflict : Conflict;
    action partial : Base { out attribute localOutput :>> output; }
    action partialOther : Other { in attribute localExtra :>> extra; }
    action reordered : Base {
        out attribute localOutput :>> output;
        in item localInput :>> input;
    }
    action ambiguous : Base {
        in item firstInput :>> input;
        in item secondInput :>> input;
    }
    part def Container { action work : Multiple; }
    part root : Container;
}
-->
