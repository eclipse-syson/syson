 * SPDX-License-Identifier: EPL-2.0
 */
package CyclicFeatures {
    part def Direct {
        part self : Direct;
    }
    part def A {
        part b : B;
    }
    part def B {
        part a : A;
    }
    part def Branches {
        part left : Direct;
        part right : Direct;
        attribute plain;
    }
    part def Leaf {
        attribute value;
    }
    part def WithSibling {
        part recursive : WithSibling;
        part child : Leaf;
        attribute tail;
    }
    part def LocalCycle {
        part back : LocalCycle {
            part local {
                attribute value;
            }
        }
    }
    part def Extra {
        part leaf : Leaf;
    }
    part def Multiple {
        part next : Extra, Multiple;
    }
    part def WithReentry {
        part back : WithReentry {
            part local {
                attribute value;
                part reentry : WithReentry;
            }
        }
    }
}
-->
