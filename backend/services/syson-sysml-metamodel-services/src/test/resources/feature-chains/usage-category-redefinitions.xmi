<?xml version="1.0" encoding="UTF-8"?>
<!--
package UsageCategoryRedefinitions {
    metadata def Tag;
    item def Payload {
        attribute value;
    }
    connection def Link {
        end part source;
        end part target;
        attribute value;
    }
    interface def Contract {
        end port source;
        end port target;
        attribute value;
    }
    state def Lifecycle {
        entry action enter;
        do action run;
        exit action leave;
        state idle;
        state done;
        transition change first idle accept signal : Payload do action effect then done;
    }
    requirement def Specification {
        assume constraint assumption;
        require constraint obligation;
        frame concern contextConcern;
        verify requirement verifiedRequirement;
    }
    case def Study {
        objective goal;
    }
    view def Visual {
        render rendering presentation;
    }
    part def Root {
        occurrence happening { attribute value; }
        event occurrence eventUse;
        item payload : Payload;
        connection link : Link;
        interface contract : Contract;
        allocation allocationUse;
        flow flowUse;
        succession flow successionFlowUse;
        binding bindingUse bind payload = payload;
        succession successionUse first payload then payload;
        enum enumerationUse;
        calc calculationUse { attribute value; }
        constraint constraintUse { attribute value; }
        assert constraint assertionUse;
        requirement requirementUse : Specification;
        assert satisfy requirement satisfactionUse;
        concern concernUse;
        viewpoint viewpointUse;
        state stateUse : Lifecycle;
        perform action performedUse;
        exhibit state exhibitedUse;
        case caseUse : Study;
        analysis analysisUse;
        verification verificationUse;
        use case useCaseUse;
        include use case includedUse;
        view viewUse : Visual;
        rendering renderingUse;
        metadata tagUse : Tag;
        action controller {
        item payload : Payload;
        action sendUse send;
        action acceptUse accept payload : Payload;
        action assignmentUse assign payload := payload;
        action ifUse if true { action branch; }
        action whileUse while true { action body; }
        action forUse for element in payload { action body; }
        action terminateUse terminate;
        decide decisionUse;
        merge mergeUse;
        fork forkUse;
        join joinUse;
        }
    }
    part context : Root;
}
-->
