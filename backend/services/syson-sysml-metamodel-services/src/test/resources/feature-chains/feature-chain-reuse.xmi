<?xml version="1.0" encoding="UTF-8"?>
<!--
package FeatureChainReuse {
    part def Child {
        attribute value;
        attribute other;
    }
    part def Root {
        part child : Child;
    }
    part shared : Root;
    part directlyOwned {
        part child : Child;
    }
    part partial : Root {
        ref part :>> child;
    }
    part complete : Root {
        part :>> child {
            attribute :>> value;
        }
    }
    part def ConfiguredRoot :> Root {
        part :>> child {
            attribute :>> value;
        }
    }
    part inherited : ConfiguredRoot;
    part sibling : ConfiguredRoot;
    part homonym : Root {
        part child;
    }
    part homonymLeaf : Root {
        part :>> child {
            attribute value;
        }
    }
}
-->
