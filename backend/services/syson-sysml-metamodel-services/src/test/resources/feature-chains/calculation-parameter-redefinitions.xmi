<!--
package ComplexParameterRedefinitions {
    calc def Compute {
        in attribute operand;
        out attribute trace;
        return attribute result;
    }
    calc def OtherCompute {
        in attribute otherOperand;
        return attribute otherResult;
    }
    calc def CombinedCompute :> Compute, OtherCompute;
    calc calculation : Compute;
    calc combinedCalculation : CombinedCompute;
}
-->
