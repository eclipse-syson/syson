<?xml version="1.0" encoding="UTF-8"?>
<!--
package Inheritance {
    part def Base {
        attribute x;
        attribute preserved;
    }
    part def Plain :> Base;
    part def Renamed :> Base {
        attribute renamed redefines Base::x;
    }
    part def Transitive :> Renamed {
        attribute finalValue redefines Renamed::renamed;
    }
    part def SharedSource :> Renamed {
        attribute selected redefines Base::x;
    }
    part def Anonymous :> Base {
        attribute redefines Base::x;
    }
    part def SameName :> Base {
        attribute x redefines Base::x;
    }
    part def Left :> Base;
    part def Right :> Base {
        attribute rightValue redefines Base::x;
    }
    part def RightSameName :> Base {
        attribute x redefines Base::x;
    }
    part def Diamond :> Left, Right;
    part def ReverseDiamond :> Right, Left;
    part def DiamondSameName :> Left, RightSameName;
    part def ReverseDiamondSameName :> RightSameName, Left;
    part def Child {
        attribute childValue;
        attribute childPreserved;
    }
    part def RefinedChild :> Child {
        attribute refined redefines Child::childValue;
    }
    part def Container {
        part sub : Child;
    }
    part def Nested :> Container {
        part redefines Container::sub {
            attribute localValue redefines Child::childValue;
        }
    }
    part def Refined :> Container {
        part sub : RefinedChild redefines Container::sub;
    }
    part plainUsage : Base;
    part configuredUsage : Base {
        attribute configured redefines Base::x;
    }
    part typedUsage : Renamed;
}
-->
